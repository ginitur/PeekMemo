  <ItemGroup>
    <ProjectReference Include="..\PeekMemo.Core\PeekMemo.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>
</Project>
