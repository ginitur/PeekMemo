<UserControl x:Class="PeekMemo.Windows.Views.DailyMemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="MemoInk" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="MemoMuted" Color="#8E8E93"/>
        <SolidColorBrush x:Key="MemoLine" Color="#30000000"/>
        <SolidColorBrush x:Key="MemoPopup" Color="#F7F7F8"/>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MemoInk}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorBox" TargetType="TextBox">
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Tag" Value="editor"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="AcceptsTab" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MemoLine}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Foreground" Value="{DynamicResource MemoInk}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource MemoInk}"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="SpellCheck.IsEnabled" Value="False"/>
            <EventSetter Event="PreviewKeyDown" Handler="OnEditorPreviewKeyDown"/>
            <EventSetter Event="LostKeyboardFocus" Handler="OnEditorLostKeyboardFocus"/>
        </Style>

        <Style x:Key="CheckHost" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,3,8,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTask}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TitleDisplayTemplate">
            <TextBlock Text="{Binding Title}"
                       FontSize="{Binding TitleSize}"
                       TextWrapping="Wrap"
                       Cursor="Arrow"
                       Background="Transparent">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextDecorations" Value="{x:Null}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding EditCommand}"/>
                </TextBlock.InputBindings>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="TitleEditorTemplate">
            <TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="{Binding TitleSize}"
                     Style="{StaticResource EditorBox}"
                     AutomationProperties.Name="Edit title"/>
        </DataTemplate>

        <DataTemplate x:Key="AddSubtaskButtonTemplate">
            <Button Content="+ Add subtask"
                    Command="{Binding AddSubtaskCommand}"
                    Style="{StaticResource QuietButton}"
                    FontSize="12"
                    Opacity="0.62"
                    Padding="0,2"
                    AutomationProperties.Name="Add subtask"/>
        </DataTemplate>

        <DataTemplate x:Key="SubtaskEditorTemplate">
            <TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource EditorBox}"
                     FontSize="13"
                     AutomationProperties.Name="New subtask"/>
        </DataTemplate>

        <DataTemplate x:Key="ChildTemplate">
            <Grid Margin="0,2,0,2" Opacity="{Binding RowOpacity}">
                <Grid.ContextMenu>
                    <ContextMenu Opened="OnMenuOpened" Closed="OnMenuClosed"
                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Delete" Command="{Binding DeleteCommand}"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          Style="{StaticResource CheckHost}"
                          IsChecked="{Binding IsCompleted, Mode=OneWay}"
                          Click="OnCheckClick"
                          PreviewMouseLeftButtonDown="OnCheckDown"
                          PreviewMouseLeftButtonUp="OnCheckUp"
                          LostMouseCapture="OnCheckLostCapture"
                          AutomationProperties.Name="{Binding CompleteName}"/>
                <ContentControl Grid.Column="1" Content="{Binding}" VerticalAlignment="Center">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource TitleDisplayTemplate}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TitleEditorTemplate}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RootTemplate">
            <StackPanel Margin="0,4,0,4">
                <Grid Opacity="{Binding RowOpacity}">
                    <Grid.ContextMenu>
                        <ContextMenu Opened="OnMenuOpened" Closed="OnMenuClosed"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Delete" Command="{Binding DeleteCommand}"/>
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              Style="{StaticResource CheckHost}"
                              IsChecked="{Binding IsCompleted, Mode=OneWay}"
                              Click="OnCheckClick"
                              PreviewMouseLeftButtonDown="OnCheckDown"
                              PreviewMouseLeftButtonUp="OnCheckUp"
                              LostMouseCapture="OnCheckLostCapture"
                              AutomationProperties.Name="{Binding CompleteName}"/>
                    <ContentControl Grid.Column="1" Content="{Binding}" VerticalAlignment="Center">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource TitleDisplayTemplate}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TitleEditorTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCategory}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Ellipse Width="6" Height="6" Fill="{Binding CategoryBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CategoryLabel}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" MaxWidth="88"/>
                    </StackPanel>
                </Grid>
                <!-- Indent matches LayoutMetrics.SubtaskIndent. -->
                <ItemsControl ItemsSource="{Binding Children}"
                              ItemTemplate="{StaticResource ChildTemplate}"
                              Margin="18,1,0,0"
                              Focusable="False"/>
                <ContentControl Content="{Binding}" Margin="18,0,0,0">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanAddSubtask}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="ContentTemplate" Value="{StaticResource AddSubtaskButtonTemplate}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEditingSubtask}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="ContentTemplate" Value="{StaticResource SubtaskEditorTemplate}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AddButtonTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.ContextMenu>
                    <ContextMenu Opened="OnMenuOpened" Closed="OnMenuClosed"
                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Add task" Click="OnAddTaskMenu"/>
                        <MenuItem Header="Add note" Click="OnAddNoteMenu"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Button Content="+ Add Task"
                        Command="{Binding AddTaskCommand}"
                        Style="{StaticResource QuietButton}"
                        AutomationProperties.Name="Add task"/>
                <Button Grid.Column="1"
                        Content="▾"
                        Style="{StaticResource QuietButton}"
                        Padding="8,3"
                        Click="OnOpenAddMenu"
                        AutomationProperties.Name="Add note"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AddEditorTemplate">
            <TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource EditorBox}"
                     AutomationProperties.Name="{Binding AddEditorName}"/>
        </DataTemplate>

        <DataTemplate x:Key="CategoryEditorTemplate">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{Binding CategoryEditorName}" FontSize="11" Opacity="0.55" Margin="0,0,0,2"/>
                <TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource EditorBox}"
                         AutomationProperties.Name="{Binding CategoryEditorName}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid TextElement.Foreground="{DynamicResource MemoInk}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image x:Name="AtmosphereImage"
               Grid.RowSpan="4"
               Width="1"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Stretch="Uniform"
               IsHitTestVisible="False"
               Focusable="False"
               Opacity="0"
               Visibility="Collapsed"
               Source="/Assets/PeekMemoMark.png"/>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="HeaderHost" SizeChanged="OnHeaderSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="‹"
                            Style="{StaticResource QuietButton}"
                            Command="{Binding ShiftEarlierCommand}"
                            FontSize="16"
                            MinWidth="28"
                            Padding="2,2"
                            AutomationProperties.Name="Previous day"/>
                    <Button x:Name="DateButton"
                            Style="{StaticResource QuietButton}"
                            Click="OnDateClick"
                            Padding="4,2"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.Name="Choose date">
                        <TextBlock x:Name="DateText"
                                   Text="{Binding DateLabel}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <Button Content="›"
                            Style="{StaticResource QuietButton}"
                            Command="{Binding ShiftLaterCommand}"
                            FontSize="16"
                            MinWidth="28"
                            Padding="2,2"
                            AutomationProperties.Name="Next day"/>
                </StackPanel>
                <Button x:Name="CategoryButton"
                        Grid.Column="1"
                        Style="{StaticResource QuietButton}"
                        SizeChanged="OnHeaderSizeChanged"
                        Click="OnCategoryClick"
                        MaxWidth="132"
                        Padding="6,2"
                        AutomationProperties.Name="Category">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FilterLabel}" TextTrimming="CharacterEllipsis" MaxWidth="108" VerticalAlignment="Center"/>
                        <TextBlock Text=" ▾" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding ProgressText}" HorizontalAlignment="Right" FontSize="12" Opacity="0.45" Margin="0,1,4,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProgressText}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <ContentControl Grid.Row="1" Content="{Binding}" Focusable="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditingCategory}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="ContentTemplate" Value="{StaticResource CategoryEditorTemplate}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <ScrollViewer Grid.Row="2"
                      Margin="0,10,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowPast}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding PastHeading}" FontSize="12" Opacity="0.55" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding PastRows}" ItemTemplate="{StaticResource RootTemplate}" Focusable="False"/>
                </StackPanel>
                <Border Height="1" Margin="0,8" Background="{DynamicResource MemoLine}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowDayDivider}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <ItemsControl ItemsSource="{Binding DailyRows}" ItemTemplate="{StaticResource RootTemplate}" Focusable="False"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" BorderBrush="{DynamicResource MemoLine}" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,8,0,0">
            <StackPanel>
                <ContentControl Content="{Binding}" Focusable="False">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource AddButtonTemplate}"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAddingRoot}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource AddEditorTemplate}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <TextBlock x:Name="QuoteText"
                           FontFamily="Georgia, Times New Roman, Cambria"
                           FontStyle="Italic"
                           FontSize="10.5"
                           Opacity="0.4"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           LineHeight="15"
                           MaxHeight="48"
                           Margin="16,8,16,6"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Popup x:Name="DatePopup"
               PlacementTarget="{Binding ElementName=DateButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="None"
               Opened="OnDatePopupOpened"
               Closed="OnDatePopupClosed">
            <Border Background="{DynamicResource MemoPopup}"
                    BorderBrush="{DynamicResource MemoLine}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
                <Calendar x:Name="MemoCalendar"
                          SelectedDatesChanged="OnCalendarSelected"
                          AutomationProperties.Name="Date"/>
            </Border>
        </Popup>

    </Grid>
</UserControl>
