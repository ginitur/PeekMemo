<win:NonActivatingWindow x:Class="PeekMemo.Windows.Views.EdgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:win="clr-namespace:PeekMemo.Windows.Windowing"
        Title="PeekMemo"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        Width="14"
        Height="56">
    <Grid>
        <Border x:Name="CollapsedChrome"
                HorizontalAlignment="Right"
                Width="3"
                CornerRadius="1.5"
                SnapsToDevicePixels="True"/>
        <Border x:Name="ExpandedChrome"
                Margin="0,0,14,0"
                CornerRadius="16"
                BorderThickness="1"
                Padding="20"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.16" Color="#000000"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Top">
                <TextBlock x:Name="TitleText" Text="PeekMemo" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubtitleText" Text="Right edge" Margin="0,6,0,0" Opacity="0.72"/>
            </StackPanel>
        </Border>
    </Grid>
</win:NonActivatingWindow>
