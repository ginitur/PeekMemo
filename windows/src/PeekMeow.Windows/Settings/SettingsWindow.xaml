<Window x:Class="PeekMeow.Windows.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PeekMeow Settings"
        Width="420"
        Height="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="General" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <CheckBox x:Name="LaunchAtStartupBox" Content="Launch at startup"/>
            <TextBlock x:Name="VersionText" Margin="0,16,0,0" Opacity="0.7"/>
            <TextBlock x:Name="BuildText" Margin="0,2,0,0" FontSize="11" Opacity="0.55"/>

            <TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,18,0,8"/>
            <TextBlock Text="Theme"/>
            <ComboBox x:Name="ThemeBox" Margin="0,4,0,10">
                <ComboBoxItem Content="System"/>
                <ComboBoxItem Content="Light"/>
                <ComboBoxItem Content="Dark"/>
            </ComboBox>
            <TextBlock Text="Panel opacity"/>
            <Slider x:Name="OpacitySlider" Minimum="0.70" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="0,4,0,10"/>
            <TextBlock Text="Edge wedge thickness"/>
            <Slider x:Name="ThicknessSlider" Minimum="2" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,10"/>
            <TextBlock Text="Edge wedge length"/>
            <Slider x:Name="LengthSlider" Minimum="32" Maximum="96" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,10"/>
            <TextBlock Text="Edge wedge opacity"/>
            <Slider x:Name="WedgeOpacitySlider" Minimum="0.20" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,10"/>
            <TextBlock Text="Edge wedge color (empty uses the theme)"/>
            <TextBox x:Name="WedgeColorBox" Margin="0,4,0,10"/>

            <TextBlock Text="Background"/>
            <ComboBox x:Name="BackgroundModeBox" Margin="0,4,0,10">
                <ComboBoxItem Content="Default"/>
                <ComboBoxItem Content="Solid"/>
                <ComboBoxItem Content="Image"/>
            </ComboBox>
            <TextBlock Text="Solid color"/>
            <TextBox x:Name="SolidColorBox" Margin="0,4,0,10"/>
            <TextBlock Text="Solid opacity"/>
            <Slider x:Name="SolidOpacitySlider" Minimum="0.40" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,10"/>
            <TextBlock Text="Image fit"/>
            <ComboBox x:Name="ImageFitBox" Margin="0,4,0,10">
                <ComboBoxItem Content="Fill"/>
                <ComboBoxItem Content="Fit"/>
            </ComboBox>
            <TextBlock Text="Image position"/>
            <ComboBox x:Name="ImagePositionBox" Margin="0,4,0,10">
                <ComboBoxItem Content="Top"/>
                <ComboBoxItem Content="Center"/>
                <ComboBoxItem Content="Bottom"/>
            </ComboBox>
            <TextBlock Text="Image opacity"/>
            <Slider x:Name="ImageOpacitySlider" Minimum="0.20" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,10"/>
            <TextBlock Text="Overlay opacity"/>
            <Slider x:Name="OverlayOpacitySlider" Minimum="0" Maximum="0.80" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,10"/>
            <TextBlock x:Name="ImageNameText" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Choose picture" Width="120" Margin="0,0,8,0" Click="ChoosePicture_Click"/>
                <Button Content="Remove picture" Width="120" Click="RemovePicture_Click"/>
            </StackPanel>

            <TextBlock x:Name="PanelSizeText" TextWrapping="Wrap" Margin="0,4,0,8"/>

            <TextBlock Text="Behavior" FontWeight="SemiBold" Margin="0,8,0,8"/>
            <TextBlock Text="Hover open delay"/>
            <ComboBox x:Name="OpenDelayBox" Margin="0,4,0,10"/>
            <TextBlock Text="Hover close delay"/>
            <ComboBox x:Name="CloseDelayBox" Margin="0,4,0,10"/>
            <CheckBox x:Name="ReduceMotionBox" Content="Reduce motion"/>

            <TextBlock x:Name="ScopeNote" TextWrapping="Wrap" Opacity="0.7" Margin="0,16,0,12"
                       Text="Drag moves the wedge between Left, Right, and Bottom. The corner grip resizes the panel. Top is not a snap edge. Pictures are copied into the local Backgrounds folder."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="88" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="OK" Width="88" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
